   Public Shared Sub ShowAcadError(ByVal iErrCode As Integer, ByVal bMsgBox As Boolean, ByVal sTitle As String)

      If bMsgBox Then
         System.Windows.Forms.MessageBox.Show("Error Code: " & CStr(iErrCode) _
  & vbCrLf & GetAcadErrText(iErrCode), sTitle)
      Else
         AcadDocument.WriteMessage(sTitle & " - Error Code: " & CStr(iErrCode) & vbCrLf & GetAcadErrText(iErrCode))
      End If
   End Sub
   Public Shared Sub ShowMapError(ByVal iErrCode As Integer, ByVal bMsgBox As Boolean, ByVal sTitle As String, Optional ByVal sAddInfo As String = "")
      If sAddInfo.Length <> 0 Then sAddInfo &= vbCrLf

      If bMsgBox Then
         System.Windows.Forms.MessageBox.Show("Error Code: " & CStr(iErrCode) _
  & vbCrLf & GetMapErrText(iErrCode), sTitle)
      Else
         AcadDocument.WriteMessage(sTitle & " - Error Code: " & CStr(iErrCode) & vbCrLf & GetMapErrText(iErrCode))
      End If
   End Sub
   Public Shared Sub GetMapEx(ByVal oSysEx As System.Exception, ByVal bMsgBox As Boolean, Optional ByVal sTitle As String = "")
      Dim oMapEx As Autodesk.Gis.Map.MapException
      Dim oMapTopoEx As Autodesk.Gis.Map.MapTopologyException
      Dim sMsg As String
      Dim iErrCode As Integer
      If sTitle.Length = 0 Then sTitle = "e300"

      Try
         Dim sType As String = oSysEx.GetType().ToString()
         Select Case sType
            Case "Autodesk.Gis.Map.MapException"
               oMapEx = DirectCast(oSysEx, Autodesk.Gis.Map.MapException)
               sMsg = oMapEx.Message
               iErrCode = oMapEx.ErrorCode
              
				Case "Autodesk.Gis.Map.MapTopologyException"
					oMapTopoEx = DirectCast(oSysEx, Autodesk.Gis.Map.MapTopologyException)
					sMsg = "Ads: " & oMapTopoEx.Message
					iErrCode = oMapTopoEx.AdsErrorCode
            Case Else
               sMsg = sType
         End Select
         If bMsgBox Then
            System.Windows.Forms.MessageBox.Show(sMsg & vbCrLf & CStr(iErrCode), sTitle)
         Else
				AcadDocument.WriteMessage(sTitle & " - Error Code: " & CStr(iErrCode) & vbCrLf & sMsg)
         End If


      Catch oEx As System.Exception
         System.Windows.Forms.MessageBox.Show(oEx.Message, "e301")
      End Try
   End Sub
End Class
