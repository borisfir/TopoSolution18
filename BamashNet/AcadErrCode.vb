   Public Shared Function GetMapErrText(ByVal iErrCode As Integer) As String
      Select Case iErrCode



         Case 0 : Return "General ADE return value: call to ADE object is not successful."
         Case 1 : Return "Invalid function argument."
         Case 2 : Return "BadInput"
         Case 3 : Return "ObjectNotFound"
         Case 4 : Return "OutOfMemory"
         Case 5 : Return "Object Not Initialized"
         Case 6 : Return "WrongType"
         Case 7 : Return "WrongProject"
         Case 8 : Return "Invalid function argument type."
         Case 9 : Return "ADSError"
         Case 10 : Return "AdsNameConvertionFails"
         Case 11 : Return "WrongArgument"
         Case 12 : Return "WriteBufFails"
         Case 13 : Return "ReadBufFails"
         Case 14 : Return "XDataCorrupted"
         Case 15 : Return "NoEnvironment"
         Case 16 : Return "UsrBreak"
         Case 17 : Return "Uncomparable"
         Case 18 : Return "Permission Denied. No permission to perform some action. When using the following commands, the message has different meanings: ADESAVEOBJS = can't be executed in demonstration mode; ADEDRAWINGS = User has no rights to update the set; ADESELOBJS, ADDREMOBJS = User has no rights to edit; ADEDWGMAINT = User needs to be superuser to remove the foreign locks; MAPOPTIONS: System Preferences = can't set ""Force User Login"" flag and change ""Object Locking"" flag if drawing set contains active or locked drawings. Deactivate or unlock the drawings before trying to set these preferences."
         Case 19 : Return "WrongSyntax"
         Case 20 : Return "Duplicate"
         Case 21 : Return "InvalidPathOrFileName"
         Case 22 : Return "InvalidVersion"
         Case 23 : Return "FileIOFatalError"

            '    External(Subsystems)
         Case 200 : Return "AcDbError"
         Case 201 : Return "IRDNotInitialized"
         Case 202 : Return "IRDError"
         Case 203 : Return "ASENotInitialized"
         Case 204 : Return "ASEError"
         Case 205 : Return "ASIError"
         Case 206 : Return "AsiNotInitialized"
         Case 207 : Return "AsiConnectToEnvironmentFailed"

            '   Transactional(Manager)
         Case 1000 : Return "Closed. Repeated attempts to close previously closed ADE object. Call support."
         Case 1001 : Return "WasErased. Attempt to work with erased ADE object. Call support."
         Case 1002 : Return "OpenForRead. Attempt to update ADE objects opened for read. Call support."
         Case 1003 : Return "OpenForWrite. Attempts to get multiple access to ADE object opened for write. Call support."
         Case 1004 : Return "WrongMode. Incorrect mode of the ADE objects should be opened. Call support."
         Case 1005 : Return "Clone. Exception at the time of cloning ADE objects. Call support."
         Case 1006 : Return "Response. Incorrect attempt to start ADE transaction. Call support."
         Case 1007 : Return "ObjIsAbsent. Attempt to work with erased ADE object. Call support."
         Case 1008 : Return "Access. Type of work with ADE does not correspond to its status. Call support."
         Case 1009 : Return "MultipleUsage. Attempts to get multiple access to ADE object opened for write. Call support."
         Case 1010 : Return "Upgrade. Incorrect attempt to update opening mode of the ADE object. Call support."
         Case 1011 : Return "NotClosed. Object was not closed during current ADE transaction. Call support."


            '  CAdeList 
         Case 1100 : Return "GetIteratorFails"
         Case 1101 : Return "ListIsEmpty"

            '  CAdeListIterator 
         Case 1102 : Return "ListEnd"
         Case 1103 : Return "ListObjectIsAbsent"


            '   Drawing 
         Case 1200 : Return "QueriedEntity Ignoring queried entity for saving selection. When using ADESAVEOBJS, the message means queried objects that are selected for save back are ignored."
         Case 1201 : Return "DwgNotActive Attempt to read the object locked from an inactive drawing. When using ADEWHOHASIT, the message means the drawing from which the object was queried is no longer active. ADE is unable to determine if the object selected is currently locked. Activate the specified drawing and reentert the command."
         Case 1202 : Return "ReadDwgFileFails ADE fails to read external drawing. If using ADEDRAWINGS, this message means that ADE is unable to read the specified drawing. Perhaps the drawing doesn't exit or the specified file is not a valid AutoCAD Drawing File. Check the error message stack for more information."
         Case 1203 : Return "MultipleUsers ADE fails to access external drawing.. If using ADEDRAWINGS, this message means ADE is unable to access the specified drawing because of file locking problems. Check the error message stack for more information."
         Case 1204 : Return "EntityLockingFails ADE fails to lock. If using ADESELOBJS, this message means ADE is unable to lock an object. The object may already be locked. Use the ADEWHOHASIT to determine if the object is locked, perhaps by another user. Check the error message stack for more information."
         Case 1205 : Return "UnlockedEntity Entity is unlocked by another ADE user. If using ADEWHOHASIT, this message indicates that the selected object is not currently locked."
         Case 1206 : Return "LockedEntity Entity has been locked by another ADE user. If using ADESELOBJS, this message indicates that the object is already locked by another user. Use the ADEWHOHASIT command to identify the user."
         Case 1207 : Return "AlreadyInSaveSet"
         Case 1208 : Return "AlreadyNotInSaveSet"
         Case 1209 : Return "MultipleReaders"
         Case 1210 : Return "OpenPrefDictionaryFails ADE fails to open ADE preferences dictionary. Call support."
         Case 1211 : Return "SavePrefDictionaryFails ADE fails to save ADE preferences dictionary. Call support."
         Case 1212 : Return "RestoreDSetFails ADE fails to restore the drawing set. Call support."
         Case 1213 : Return "OpenDSetDictionaryFails ADE fails to open ADE drawing set dictionary. Call support."
         Case 1214 : Return "SaveDSetDictionaryFails ADE fails to save ADE drawing set in dictionary. Call support."
         Case 1215 : Return "OpenQueryDictionaryFails ADE fails to open ADE query library dictionary. Call support."
         Case 1216 : Return "SaveQueryDictionaryFails ADE fails to save ADE query library in dictionary. Call support."
         Case 1217 : Return "OpenRTableDictionaryFails ADE fails to open ADE range table dictionary. Call support."
         Case 1218 : Return "SaveRTableDictionaryFails ADE fails to save ADE range table in dictionary. Call support."
         Case 1219 : Return "RestoreRTableDictionaryFails ADE fails to restore ADE range table in dictionary. Call support."
         Case 1220 : Return "OpenDocViewDictionaryFails ADE fails to open ADE Doc View information dictionary. Call support."
         Case 1221 : Return "SaveDocViewDictionaryFails ADE fails to save ADE Doc View information in dictionary. Call support."
